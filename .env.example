# Copy to .env.local and fill in. Never commit .env.local: it holds secrets.
# The sample page at /demo works without any of these; everything else needs them.

# Neon Postgres. Use the pooled connection string (host contains "-pooler").
DATABASE_URL=

# Neon Auth (managed sign-in). Find the base URL in the Neon console under Auth.
NEON_AUTH_BASE_URL=
# Signs the session cookie. At least 32 random characters, for example: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Neon object storage for uploaded photos. The bucket needs public read access.
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MEDIA_BUCKET=media

# The site's public address, without a trailing slash. Used in share links, QR codes and
# preview images, for example https://yourdomain.com
SITE_URL=http://localhost:3000

# Encrypts the Mailchimp and Kit API keys creators connect for their sign-up tiles. At least 32
# random characters, for example: openssl rand -base64 32. Without it, newsletter connections
# are switched off (sign-ups are still collected and downloadable).
SECRETS_KEY=

# Custom domains. Creators point a subdomain (links.theirname.com) at this site with a CNAME to
# DOMAIN_CNAME_TARGET, which defaults to SITE_URL's host. For bare domains (theirname.com) set
# DOMAIN_A_RECORD to your host's IP address; without it, only subdomains can be connected.
# On Vercel: DOMAIN_CNAME_TARGET=cname.vercel-dns.com and DOMAIN_A_RECORD=76.76.21.21.
DOMAIN_CNAME_TARGET=
DOMAIN_A_RECORD=

# Vercel only: lets the app add a verified domain to the project, so Vercel serves it and issues
# its HTTPS certificate. Create a token under Account Settings → Tokens. Leave empty elsewhere.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
